# Copy to backend/.env. Never commit real secrets.
DEMO_MODE=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side secret key (sb_secret_...) or legacy service_role key; never anon key.
SUPABASE_SECRET_KEY=
VISION_API_KEY=change-this-to-a-long-random-camera-key
DASHBOARD_API_KEY=change-this-to-a-different-long-random-dashboard-key
SCAN_COOLDOWN_SECONDS=60
MIN_CONFIDENCE=0.65
# Local demo only; never use SQLite for deployed Vercel functions.
DEMO_DB_PATH=parking_demo.sqlite3
